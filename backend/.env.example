# 复制为 .env 后按需修改：cp .env.example .env

# 应用
APP_NAME=仓储管理系统
APP_VERSION=1.0.0
DEBUG=true

# 数据库（默认 root/root@localhost:3306/warehouse_erp）
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/warehouse_erp?charset=utf8mb4
# 是否打印 SQL，调试时可设为 true
DB_ECHO=false

# JWT：生产环境务必替换 JWT_SECRET_KEY
JWT_SECRET_KEY=warehouse-erp-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# CORS 允许的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173

# 分页
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200
