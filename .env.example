# 复制为 .env 后替换所有 replace-with-* 值；不要提交真实密钥。
COMPOSE_PROJECT_NAME=warehouse-erp
TZ=Asia/Shanghai

# PostgreSQL 16（中枢与 WMS 同库、跨 schema）
POSTGRES_USER=warehouse_erp
POSTGRES_PASSWORD=replace-with-strong-database-password
POSTGRES_DB=warehouse_erp
DB_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
# 本机直连示例：
DATABASE_URL=postgresql+asyncpg://warehouse_erp:replace-with-strong-database-password@localhost:5432/warehouse_erp

# 中枢 FastAPI
BACKEND_BIND_HOST=127.0.0.1
BACKEND_PORT=8000
HUB_JWT_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_MINUTES=480
BOOTSTRAP_USERNAME=ops
BOOTSTRAP_PASSWORD=replace-with-bootstrap-password
WMS_API_TOKEN=replace-with-wms-api-token
WEBHOOK_SECRET=replace-with-webhook-hmac-secret
WEBHOOK_TOLERANCE_SECONDS=300
SENTRY_BASE_URL=http://wms:5000/api/v1
SENTRY_TOKEN=replace-with-sentry-token
SENTRY_TIMEOUT_SECONDS=10
# 超时提醒扫描周期（秒）；设为 0 关闭后台扫描，仅保留手工 POST /system/timeouts/scan。
TIMEOUT_SCAN_INTERVAL_SECONDS=300

# 运营端 React/Vite
FRONTEND_OPS_BIND_HOST=127.0.0.1
FRONTEND_OPS_PORT=4173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEMO_FALLBACK=false

# sentry-wms（仅启用 wms profile 时使用）
WMS_BIND_HOST=127.0.0.1
WMS_PORT=5000
WMS_ADMIN_BIND_HOST=127.0.0.1
WMS_ADMIN_PORT=8080
WMS_FLASK_ENV=production
WMS_TRUST_PROXY=false
WMS_CORS_ORIGINS=http://localhost:8080,http://localhost:4173
WMS_JWT_SECRET=replace-with-at-least-32-random-bytes
REDIS_PASSWORD=replace-with-strong-redis-password
# 仓库端 Hub 页面的代理（wms 后端 → 中枢）。HUB_WMS_TOKEN 复用 WMS_API_TOKEN，
# 不需要单独配置；HUB_BASE_URL 仅在非默认部署时需要覆盖。
HUB_BASE_URL=http://backend:8000
# 使用 Python cryptography.fernet.Fernet.generate_key() 生成。
SENTRY_ENCRYPTION_KEY=replace-with-valid-fernet-key
SENTRY_TOKEN_PEPPER=replace-with-token-pepper-at-least-32-bytes
SENTRY_PUBSUB_HMAC_KEY=replace-with-pubsub-hmac-at-least-32-bytes
SENTRY_INBOUND_MAX_BODY_KB=256
INBOUND_RATE_LIMIT_PER_MINUTE=500

# WMS webhook dispatcher
DISPATCHER_ENABLED=true
DISPATCHER_HTTP_TIMEOUT_MS=10000
DISPATCHER_HTTP_CONNECT_TIMEOUT_MS=3000
DISPATCHER_HTTP_READ_TIMEOUT_MS=7000
DISPATCHER_FALLBACK_POLL_MS=2000
DISPATCHER_SHUTDOWN_DRAIN_S=30
DISPATCHER_MAX_CONCURRENT_POSTS=16
DISPATCHER_MAX_PENDING_HARD_CAP=50000
DISPATCHER_MAX_DLQ_HARD_CAP=5000
# 生产环境保持 false；仅本地联调私网 HTTP webhook 时按需开启。
SENTRY_ALLOW_HTTP_WEBHOOKS=false
SENTRY_ALLOW_INTERNAL_WEBHOOKS=false
